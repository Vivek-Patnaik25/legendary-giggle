# Pantry Rescue Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Application Environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Session & Security
# Generate a secure random secret in production (at least 32 characters)
SESSION_SECRET=pantry-rescue-super-secure-dev-session-secret-at-least-32-chars-long!
COOKIE_NAME=pantry_rescue_session
COOKIE_SECURE=false

# Database Configuration
# Supported: sqlite://./data/pantry.db or postgres://user:password@localhost:5432/pantry_rescue
DATABASE_URL=sqlite://./data/pantry.db

# Reverse Proxy / Load Balancer Configuration
LB_PORT=3000
API_REPLICAS=2
API_PORTS=3001,3002

# External Services (Free APIs)
OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org
THE_MEAL_DB_URL=https://www.themealdb.com/api/json/v1/1
USER_AGENT=PantryRescue/1.0.0 (https://github.com/Vivek-Patnaik25/legendary-giggle; contact: dev@pantryrescue.local)

# Cache TTL (in seconds)
BARCODE_CACHE_TTL=86400
RECIPE_CACHE_TTL=86400

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Log Level
LOG_LEVEL=info
