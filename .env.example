# Pantry Rescue Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Application Environment
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Session & Security
# REQUIRED in production. Generate a secure random string (at least 32 characters).
# On Render, set via Dashboard or let render.yaml generateValue: true handle it automatically.
SESSION_SECRET=generate-a-secure-random-32-character-secret-do-not-commit
COOKIE_SECURE=true

# Database Configuration
# Local dev: sqlite://./data/pantry.db
# Render with persistent disk: sqlite:///var/data/pantry.db
DATABASE_URL=sqlite:///var/data/pantry.db

# Reverse Proxy / Load Balancer Configuration (local multi-replica testing only)
LB_PORT=3000
API_PORTS=3001,3002

# External Services (100% Free Public APIs - No keys required)
OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org
THE_MEAL_DB_URL=https://www.themealdb.com/api/json/v1/1
USER_AGENT=PantryRescue/1.0.0 (https://github.com/Vivek-Patnaik25/legendary-giggle; contact: dev@pantryrescue.local)

# Cache TTL (in seconds)
BARCODE_CACHE_TTL=86400
RECIPE_CACHE_TTL=86400

# Rate Limiting
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
