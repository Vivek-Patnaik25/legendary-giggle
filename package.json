{
  "name": "pantry-rescue",
  "version": "1.0.0",
  "description": "Shared household fridge and pantry tracker that turns food about to expire into dinner ideas and gamifies waste reduction.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "tsx src/server/index.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm rebuild better-sqlite3 && npm run build:client && npm run build:server",
    "start": "node dist-server/server/index.js",
    "start:web": "node dist-server/server/index.js",
    "start:cluster": "tsx src/server/cluster.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/smoke-test.ts",
    "test:load": "tsx scripts/load-test.ts",
    "test:acceptance": "tsx scripts/verify-acceptance.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "10.1.6",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "canvas-confetti": "^1.9.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "idb": "^8.0.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "ffprobe-static": "^3.1.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "postcss-selector-parser": "^7.1.6"
  }
}
